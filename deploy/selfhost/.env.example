# Copier en .env (jamais commité) et remplir. Générer des valeurs fortes :
#   openssl rand -base64 32
POSTGRES_PASSWORD=
# Accès web : nom d'utilisateur et empreinte bcrypt du mot de passe, générée par :
#   docker run --rm caddy:2.10.0 caddy hash-password --plaintext 'ton-mot-de-passe'
# Dans ce fichier, doubler chaque « $ » de l'empreinte (« $$ ») pour Docker Compose.
PRIMESTONE_WEB_USER=moi
PRIMESTONE_WEB_PASSWORD_HASH=

# Facultatif (gratuit) : clé YouTube Data API, OAuth lecture seule de ta chaîne.
# PRIMESTONE_YOUTUBE_API_KEY=
# PRIMESTONE_YOUTUBE_OAUTH_CLIENT_ID=
# PRIMESTONE_YOUTUBE_OAUTH_CLIENT_SECRET=
# PRIMESTONE_YOUTUBE_OAUTH_REFRESH_TOKEN=

# Facultatif : rédaction et plongements par modèles locaux (après « ollama pull »).
# PRIMESTONE_EDITORIAL_WRITER=ollama
# PRIMESTONE_EMBEDDER=ollama
