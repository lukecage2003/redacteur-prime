# Copier en .env pour le développement local. Ne jamais versionner .env.
PRIMESTONE_ENVIRONMENT=development
PRIMESTONE_LOG_LEVEL=INFO
PRIMESTONE_DATABASE_URL=postgresql+psycopg://primestone:primestone@localhost:5432/primestone
# Base JETABLE pour les tests d'intégration (le nom doit contenir « test »).
PRIMESTONE_TEST_DATABASE_URL=postgresql+psycopg://primestone:primestone@localhost:5432/primestone_test
PRIMESTONE_AI_PROVIDER=fake
PRIMESTONE_AI_BUDGET_PER_MISSION_USD=5.00
# Market Intelligence : clé GRATUITE YouTube Data API v3 (facultative, quota 10 000 unités/jour)
# PRIMESTONE_YOUTUBE_API_KEY=
# Statistiques de TA chaîne (phase 14) : client OAuth « application de bureau », gratuit
# PRIMESTONE_YOUTUBE_OAUTH_CLIENT_ID=
# PRIMESTONE_YOUTUBE_OAUTH_CLIENT_SECRET=
# PRIMESTONE_YOUTUBE_OAUTH_REFRESH_TOKEN=   (obtenu par : primestone-performance authorize)
# Voix (phase 12) : serveurs LOCAUX gratuits, installés par le propriétaire
# PRIMESTONE_VOICE_STT=whisper_cpp
# PRIMESTONE_WHISPER_CPP_URL=http://localhost:8080
# PRIMESTONE_VOICE_TTS=piper
# PRIMESTONE_PIPER_URL=http://localhost:5000
# Cloud uniquement (obligatoires hors développement, voir docs/operations/production-checklist.md)
# PRIMESTONE_STORAGE_BACKEND=gcs
# PRIMESTONE_GCS_BUCKET=
# PRIMESTONE_IAP_AUDIENCE=/projects/NUMERO/global/backendServices/ID
# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
