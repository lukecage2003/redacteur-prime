# Copier en .env pour le développement local. Ne jamais versionner .env.
PRIMESTONE_ENVIRONMENT=development
PRIMESTONE_LOG_LEVEL=INFO
PRIMESTONE_DATABASE_URL=postgresql+psycopg://primestone:primestone@localhost:5432/primestone
# Base JETABLE pour les tests d'intégration (le nom doit contenir « test »).
PRIMESTONE_TEST_DATABASE_URL=postgresql+psycopg://primestone:primestone@localhost:5432/primestone_test
PRIMESTONE_AI_PROVIDER=fake
PRIMESTONE_AI_BUDGET_PER_MISSION_USD=5.00
# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
